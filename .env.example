APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT= # Tu puerto de MySQL
DB_NAME=netx_db
DB_USER= # Tu usuario adminstrador de MySQL
DB_PASS= # Contraseña
DB_CHARSET=utf8mb4

SESSION_NAME=NETXSESSID
SESSION_LIFETIME=28800

# Esta variable sirve para especificar la contraseña de un usuario que se crea de manera automatica en la base de datos.
NETX_SEED_PASSWORD=Netx2026*
